{
  "$extends": [
    "#/$defs/base-component"
  ],
  "$componentKey": "CategoryCards",
  "$componentTitle": "Category Cards",
  "title": "Category Cards",
  "description": "Tarjetas en diseño flexible con imagen y texto de categorías",
  "type": "object",
  "required": [
    "title"
  ],
  "properties": {
    "title": {
      "title": "Título",
      "type": "string"
    },
    "images": {
      "title": "Tarjetas",
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "title": "Tarjeta",
        "type": "object",
        "required": [
          "imageTitle",
          "imageAlt",
          "link",
          "imageSrcDesktop",
          "imageSrcMobile"
        ],
        "properties": {
          "imageTitle": {
            "type": "string",
            "title": "Título de Imagen"
          },
          "imageAlt": {
            "type": "string",
            "title": "Texto Alternativo de Imagen"
          },
          "link": {
            "type": "string",
            "title": "Enlace"
          },
          "imageSrcDesktop": {
            "type": "string",
            "title": "Imagen de Escritorio",
            "widget": {
              "ui:widget": "media-gallery",
              "restrictMediaTypes": {
                "video": true,
                "image": [
                  "png",
                  "jpg",
                  "jpeg",
                  "gif",
                  "svg",
                  "webp"
                ]
              }
            }
          },
          "imageSrcMobile": {
            "type": "string",
            "title": "Imagen Móvil",
            "widget": {
              "ui:widget": "media-gallery",
              "restrictMediaTypes": {
                "video": true,
                "image": [
                  "png",
                  "jpg",
                  "jpeg",
                  "gif",
                  "svg",
                  "webp"
                ]
              }
            }
          }
        }
      }
    }
  },
  "readOnly": false,
  "writeOnly": false,
  "deprecated": false,
  "$abstract": false
}
