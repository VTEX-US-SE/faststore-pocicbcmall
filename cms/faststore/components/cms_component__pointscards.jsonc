{
  "$extends": [
    "#/$defs/base-component"
  ],
  "$componentKey": "PointsCards",
  "$componentTitle": "Points Card",
  "title": "Points Card",
  "description": "Tarjetas en diseño flexible con imagen y texto de categorías",
  "type": "object",
  "properties": {
    "title": {
      "title": "Título",
      "type": "string"
    },
    "items": {
      "title": "Tarjeta de Puntos",
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "title": "Tarjeta",
        "type": "object",
        "required": [
          "title",
          "subtitle",
          "text"
        ],
        "properties": {
          "title": {
            "type": "string",
            "title": "título de la tarjeta"
          },
          "subtitle": {
            "type": "string",
            "title": "subtítulo de la tarjeta"
          },
          "text": {
            "type": "string",
            "title": "texto de la tarjeta"
          }
        }
      }
    }
  },
  "readOnly": false,
  "writeOnly": false,
  "deprecated": false,
  "$abstract": false
}
